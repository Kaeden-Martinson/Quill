# Copy to quill.env and fill in. quill.env is never committed.
QUILL_PASSCODE=pick-a-long-invite-code
QUILL_MODEL=gemma4:e4b
# QUILL_HOST=0.0.0.0   # uncomment for Wi-Fi or Tailscale access; leave off for Cloudflare Tunnel

# ---- How each job picks its next words ----
# temperature: 0 = always the most likely word; higher = more varied (0.3 strict, 0.75 natural, 1+ loose)
# top_p: only pick from the most likely words that add up to this share (0.9 = drop the unlikely 10%)
# top_k: only pick from this many top words.  min_p: drop words below this fraction of the top word's odds
# repeat_penalty: above 1 discourages repeating recent words (1.1 is gentle)
# seed: a number makes output repeatable. Delete a line to use the default. Restart Quill after changes.
# Line edits (0 = always the single most likely fix; scored best on the reliability test)
QUILL_EDIT_TEMPERATURE=0
# The letter about the whole essay
QUILL_LETTER_TEMPERATURE=0.4
QUILL_LETTER_TOP_P=0.9
# Drafting from a prompt (training/writing_eval/REPORT.md: no repeat penalty, min_p instead of top_p)
QUILL_DRAFT_TEMPERATURE=0.8
QUILL_DRAFT_TOP_P=1.0
QUILL_DRAFT_MIN_P=0.05
QUILL_DRAFT_REPEAT_PENALTY=1.0
# Output caps in tokens (gemma's hidden thinking counts): edits 800, letter 2048, drafts 4096
# QUILL_EDIT_NUM_PREDICT=800
# QUILL_LETTER_NUM_PREDICT=2048
# QUILL_DRAFT_NUM_PREDICT=4096
